# 统一换行：shell / PowerShell / 文本一律 LF，避免 Windows 上 CRLF 把脚本搞坏
* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=lf
*.psm1 text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.conf text eol=lf
*.mdc  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
